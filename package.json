{
  "name": "sigplot",
  "description": "Advanced plotting for signal processing applications",
  "version": "3.1.7",
  "engines": {
    "node": ">=18"
  },
  "homepage": "http://github.com/spectriclabs/sigplot",
  "main": "dist/sigplot.js",
  "module": "dist/sigplot.esm.js",
  "types": "dist/types/sigplot.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/sigplot.d.ts",
      "import": "./dist/sigplot.esm.js",
      "require": "./dist/sigplot.js"
    },
    "./plugins": {
      "types": "./dist/types/plugins.d.ts",
      "import": "./dist/sigplot.plugins.js",
      "require": "./dist/sigplot.plugins.js"
    }
  },
  "files": [
    "js",
    "dist/sigplot.js",
    "dist/sigplot.min.js",
    "dist/sigplot.esm.js",
    "dist/sigplot.plugins.js",
    "dist/sigplot.plugins.min.js",
    "dist/types"
  ],
  "author": {
    "name": "Spectric Labs, Inc.",
    "email": "foss@spectric.com",
    "url": "http://www.spectric.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/spectriclabs/sigplot.git"
  },
  "bugs": {
    "url": "https://github.com/spectriclabs/sigplot/issues"
  },
  "license": "apache-2.0",
  "licenses": [
    {
      "type": "apache-2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "scripts": {
    "build": "node esbuild.config.mjs && npm run types",
    "dev": "vite",
    "lint": "biome lint js/",
    "lint:fix": "biome lint --write js/",
    "format": "biome format --write js/ test/",
    "format:check": "biome format js/ test/",
    "docs": "rm -rf ./doc/ && typedoc",
    "clean": "rm -rf dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit",
    "types": "tsgo --declaration --declarationDir dist/types --emitDeclarationOnly",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "loglevel": "^1.4.1",
    "sigfile": "^0.1.9",
    "tinycolor2": "^1.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/tinycolor2": "^1.4.6",
    "@typescript/native-preview": "^7.0.0-dev.20260320.1",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "bootstrap": "^5.0.0-beta3",
    "esbuild": "^0.27.3",
    "express": "^4.13.4",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "typedoc": "^0.28.17",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
